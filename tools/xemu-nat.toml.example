# Add to your xemu config: user-mode NAT with FTP port forwarding (see tools/xemu_ftp.sh)
[net]
enable = true
backend = 'nat'

[net.nat]
forward_ports = [
    {host = 2121, guest = 21, protocol = 'tcp'},
    {host = 50000, guest = 50000, protocol = 'tcp'},
    {host = 50001, guest = 50001, protocol = 'tcp'},
    {host = 50002, guest = 50002, protocol = 'tcp'},
